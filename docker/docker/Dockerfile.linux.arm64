FROM golang:1.26.10@sha256:24a707af49702fa44f02785475d02fb752f6982d3e9c0afb7696e1f0204e7ce9 AS patched-tools
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gcc \
        git \
        libc6-dev \
        libseccomp-dev \
        make \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*
COPY scripts/build-docker-28-patched-binaries.sh /usr/local/bin/
RUN bash /usr/local/bin/build-docker-28-patched-binaries.sh

# Keep Docker 28 DinD behavior (overlay2, no Engine 29 containerd-store /
# API / attestation defaults) while replacing bundled Go binaries with a
# source-identical build from the incident-patched Go toolchain (matches
# drone-docker; avoids CI-22663 / CI-22901 class regressions).
FROM arm64v8/docker:28.5.2-dind
RUN apk add --no-cache 'ca-certificates>=20261020-r0'

ENV DOCKER_HOST=unix:///var/run/docker.sock

ENV DOCKER_BUILDKIT=1
ENV BUILDKIT_PROGRESS=plain
ENV DOCKER_CLI_EXPERIMENTAL=enabled
ENV PLUGIN_BUILDKIT_ASSETS_DIR=/buildkit

COPY --from=patched-tools \
    /out/containerd \
    /out/containerd-shim-runc-v2 \
    /out/ctr \
    /out/docker \
    /out/docker-proxy \
    /out/dockerd \
    /out/runc \
    /usr/local/bin/
COPY --from=patched-tools /out/docker-buildx /usr/local/libexec/docker/cli-plugins/docker-buildx
COPY --from=patched-tools /out/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose

# Create /buildkit directory
RUN mkdir -p /buildkit

# Add buildkit.tar and version
COPY buildkit/buildkit.tar /buildkit/buildkit.tar
COPY buildkit/version.json /buildkit/version.json

ADD release/linux/arm64/drone-docker /bin/
ENTRYPOINT ["/usr/local/bin/dockerd-entrypoint.sh", "/bin/drone-docker"]
